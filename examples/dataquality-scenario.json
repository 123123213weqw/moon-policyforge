{
  "operation": "decide",
  "mode": "all",
  "rules": [
    {
      "id": "auto_pass",
      "priority": 3,
      "when": "quality.score >= 0.95 && quality.completeness == 1.0",
      "output": "auto_pass"
    },
    {
      "id": "manual_review",
      "priority": 2,
      "when": "quality.score >= 0.80 && quality.score < 0.95",
      "output": "manual_review"
    },
    {
      "id": "reject",
      "priority": 1,
      "when": "quality.score < 0.80",
      "output": "reject"
    },
    {
      "id": "quarantine",
      "priority": 1,
      "when": "quality.completeness < 0.5",
      "output": "quarantine"
    }
  ],
